# Release signing must run from this macOS account.
MAC_RELEASE_USER=cutecat

# Created with:
# xcrun notarytool store-credentials "your-profile-name"
APPLE_KEYCHAIN_PROFILE=your-profile-name

# Optional when the notary credentials are in a non-default keychain.
# APPLE_KEYCHAIN=/path/to/login.keychain-db

# Area90 FTPS credentials. Do not commit the real .env file.
FTP_HOST=ftp.area90.com
FTP_PORT=21
FTP_USER=
FTP_PASS=
FTP_REMOTE_DIR=new-text-file
PUBLIC_BASE_URL=https://area90.com/releases/new-text-file
