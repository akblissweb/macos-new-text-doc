# Local macOS account that owns the release-signing certificates.
MAC_RELEASE_USER=your-release-account

# Name of a notarytool credentials profile stored in Keychain.
APPLE_KEYCHAIN_PROFILE=your-notary-profile

# Optional when the notary credentials are in a non-default keychain.
# APPLE_KEYCHAIN=/absolute/path/to/keychain-db

# FTPS destination. Never commit real credentials in this file.
FTP_HOST=ftp.example.com
FTP_PORT=21
FTP_USER=your-ftp-user
FTP_PASS=your-ftp-password
FTP_REMOTE_DIR=path/to/releases
PUBLIC_BASE_URL=https://downloads.example.com/project
